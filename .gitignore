__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Local data — regenerated by the engine, never committed.
# data/ is the local run's output and web/ is what CI publishes; keeping them
# separate stops the same generated file being written from two places and
# conflicting on every rebase.
data/*.sqlite
data/cache/
data/latest.json
data/report.html
data/lastman.html

# The published copy is written by CI, which force-adds it. Ignoring it here
# means a local run can never stage a competing version.
web/latest.json
web/report.html
web/lastman.html

# record/ is deliberately NOT ignored. It is the durable prediction log, and the
# only copy that survives — every machine this runs on is disposable.
# The entered-team override is the exception: it is per-machine, per-week state,
# not part of the log, and must never be committed from a local run.
record/myteam.json
.env
secrets.toml
