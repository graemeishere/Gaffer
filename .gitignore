__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Local data — regenerated by the engine, never committed.
# data/ is the local run's output and web/ is what CI publishes; keeping them
# separate stops the same generated file being written from two places and
# conflicting on every rebase.
data/*.sqlite
data/cache/
data/latest.json
data/report.html
.env
secrets.toml
