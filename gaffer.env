# Committed defaults. Neither value is a secret — a team ID and a league ID are
# both visible in the Fantasy Premier League site's own URLs — so they live here
# rather than in a secret store, and CI, a VPS and a laptop all pick them up
# without being configured separately.
#
# Precedence, highest first:
#   1. a real environment variable, or --entry / --league on the command line
#   2. .env beside the checkout   (gitignored, per-machine)
#   3. this file                  (committed, shared)

# Worrall FC
GAFFER_ENTRY=6674798

# The workplace mini-league: "Cutting Edge Services", head-to-head, starts GW1.
# The classic-league endpoint 404s for this, which is why it first looked like a
# league that did not exist — head-to-head leagues live at a different path.
GAFFER_LEAGUE=1376747
